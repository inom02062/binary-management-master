generator client {
  provider = "prisma-client-js"
  output   = "../../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Block {
  id           String      @id @default(cuid())
  name         String
  x            Float
  y            Float
  width        Float
  height       Float
  floorsCount  Int
  aptsPerFloor Int
  color        String
  imageUrl     String?
  apartments   Apartment[]
}

model Apartment {
  id                String    @id @default(cuid())
  blockId            String
  floor              Int
  number             Int
  status             String    @default("EMPTY")
  tenantName         String?
  tenantSurname      String?
  totalAmount        Float?
  downPayment        Float     @default(0)
  firstDueDate       String?
  installmentMonths  Int?
  scheduleBasePaid   Float     @default(0)
  gracePeriodDays    Int       @default(0)
  layoutX            Float?
  layoutY            Float?
  layoutWidth        Float?
  layoutHeight       Float?
  block              Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  payments           Payment[]
}

model Payment {
  id          String    @id @default(cuid())
  apartmentId String
  amount      Float
  date        DateTime
  note        String?
  status      String    @default("PAID")
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  tenantId     String?
  permissions  String?  @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  sessions     AuthSession[]
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model Tenant {
  id          String   @id
  name        String
  databaseUrl String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  users       User[]
}

model ActivityLog {
  id        String   @id
  username  String
  tenantId  String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
